# Frontend Environment Variables (.env.production.example)

# 1. Backend Server URL
# IMPORTANT: Provide the Public IP or Domain Name of your EC2 backend server here.
# Example: http://192.168.1.10:3000
VITE_API_BASE_URL=http://<BACKEND_EC2_IP_OR_DOMAIN>:3000

# 2. AWS Cognito Parameters
# Fill these with your Cognito pool details
VITE_COGNITO_CLIENT_ID=YOUR_COGNITO_CLIENT_ID
VITE_COGNITO_DOMAIN=YOUR_COGNITO_DOMAIN.auth.eu-north-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://<FRONTEND_EC2_IP_OR_DOMAIN>
VITE_COGNITO_LOGOUT_URI=http://<FRONTEND_EC2_IP_OR_DOMAIN>
# Optional depending on your AWS setup:
# VITE_COGNITO_SCOPE=email openid phone
