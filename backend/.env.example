# ============================================
# AWS Cognito Configuration
# ============================================

# Cognito User Pool ID — AWS konsolunda User Pools > Pool details
COGNITO_CLIENT_ID=3goaugoucjih24ocs2v7n3insn

# Client Secret — User Pools > App clients > App client secret
COGNITO_CLIENT_SECRET=BURAYA_CLIENT_SECRET_YAZIN

# Cognito Issuer URL (region ve pool ID'yi kendi değerlerinle değiştir)
COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_jLm05CRkG

# Cognito Hosted UI Domain — User Pools > App integration > Domain
# Örnek: https://guvenilir-mi.auth.eu-north-1.amazoncognito.com
COGNITO_DOMAIN=https://BURAYA_USER_POOL_DOMAIN_YAZIN.auth.eu-north-1.amazoncognito.com

# Redirect URI — Cognito App client'ta tanımlı olmalı
COGNITO_REDIRECT_URI=https://d84l1y8p4kdic.cloudfront.net

# Logout URI — Cognito App client'ta tanımlı olmalı
COGNITO_LOGOUT_URI=https://d84l1y8p4kdic.cloudfront.net

# ============================================
# Session Configuration
# ============================================

# Güçlü ve rastgele bir string kullan (örn: openssl rand -hex 32)
SESSION_SECRET=BURAYA_GUVENLI_BIR_SESSION_SECRET_YAZIN

# ============================================
# Server
# ============================================

PORT=3001
